<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure decision logic (no AutoCAD references) so it can be unit-tested on any OS.
       net47: used by the AutoCAD 2020-2024 plugin (same target as the AutoCAD.NET packages).
       netstandard2.0: used by the unit tests on modern .NET. -->
  <PropertyGroup>
    <TargetFrameworks>net47;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ACadHotKey.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
